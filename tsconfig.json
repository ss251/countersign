{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@countersign-hub/relay/paywall": ["./packages/relay/src/paywall.ts"],
      "@countersign-hub/relay/pay-fetch": ["./packages/relay/src/pay-fetch.ts"],
      "@countersign-hub/relay/browser": ["./packages/relay/src/browser.ts"]
    }
  },
  "include": [
    "apps/*/src",
    "apps/*/test",
    "packages/*/src",
    "packages/*/test",
    "scripts",
    "examples",
    "e2e"
  ]
}
