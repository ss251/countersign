{
  "name": "countersign",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:contracts": "forge test",
    "gate": "bun run typecheck && bun test && forge test",
    "web:build": "bun run --cwd apps/web build",
    "hub": "bun run --cwd apps/hub start",
    "e2e": "bun run --cwd e2e start"
  },
  "devDependencies": {
    "@countersign/relay": "workspace:*",
    "@openzeppelin/contracts": "5.6.1",
    "@types/bun": "1.3.x",
    "forge-std": "github:foundry-rs/forge-std#v1.17.0",
    "hono": "^4.13.16",
    "typescript": "5.9.3",
    "viem": "^2.57.16"
  }
}
